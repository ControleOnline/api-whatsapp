HOST=0.0.0.0
PORT=3000
FROMME=1
STORE=1

API_KEY=
WEBHOOK=

# Formato: major,minor,revision (ex: 2,3000,1023223821)
# Se não definido, usa a versão mais recente automaticamente
WA_VERSION=

WHISPER_PORT=3002
WHISPER_MODEL=small

# RabbitMQ (opcional)
RABBITMQ_ENABLED=0
RABBITMQ_URL=
RABBITMQ_WEBHOOK_QUEUE=whatsapp.webhooks
RABBITMQ_OUTBOUND_QUEUE=whatsapp.outbound
RABBITMQ_PREFETCH=5

# Armazenamento de sessões: filesystem (padrão), redis ou memcache
STORAGE_DRIVER=filesystem
STORAGE_PREFIX=api-whatsapp
REDIS_URL=
MEMCACHE_SERVERS=
MEMCACHE_USERNAME=
MEMCACHE_PASSWORD=
